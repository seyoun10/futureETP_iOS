    "alertSettings.guide" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checked every 15 minutes during trading hours; each level alerts at most once per CME trading day. You are alerted when today's candle wick touches a rare-level line on the chart (intraday touches, so alerts can fire more often than p%)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장중 15분마다 확인하며 레벨별로 CME 거래일당 1회 알려 드립니다. 차트의 rare-level 선에 오늘 봉의 꼬리가 닿으면 알립니다(장중 터치 기준이라 p%보다 자주 울릴 수 있음)."
          }
        }
      }
    },
